<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DeskPals-Instalador.exe: the setup for people who do not have the .NET 10 Desktop Runtime yet.
    It is built for the .NET Framework 4.8 that comes with every Windows 10/11, so it always opens.
    It checks the .NET 10 Desktop Runtime, offers Microsoft's official installer when it is missing (Install stays
    disabled until it is there), then installs DeskPals.exe (embedded) like the program's own installer does.
    Build: dotnet build Tools\Setup\Setup.csproj -c Release -p:AppExe=<path of DeskPals.exe>   (Tools\release.ps1 does it)
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>DeskPals-Instalador</AssemblyName>
    <RootNamespace>DesktopPetSetup</RootNamespace>
    <ApplicationIcon>..\..\src\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- the published single-file DeskPals.exe (Tools\release.ps1 passes it) -->
    <AppExe Condition="'$(AppExe)' == ''">..\..\publish\DeskPals.exe</AppExe>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>DeskPals</Product>
    <AssemblyTitle>Instalador do DeskPals</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <EmbeddedResource Include="$(AppExe)" LogicalName="DesktopPet.exe" />
    <!-- the Pet Editor, installed next to the program (Tools\release.ps1 passes it; left out when not built) -->
    <EmbeddedResource Include="$(EditorExe)" LogicalName="PetEditor.exe" Condition="'$(EditorExe)' != '' And Exists('$(EditorExe)')" />
    <EmbeddedResource Include="..\..\src\Images\logo.png" LogicalName="logo.png" />
    <!-- the same uninstall.cmd as the program's own installer -->
    <Compile Include="..\..\src\Portable\UninstallScript.cs" Link="UninstallScript.cs" />
  </ItemGroup>

</Project>
